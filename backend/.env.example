ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./roda.db
# Neon pooled connection used by the running Render service:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB
# Neon direct connection used only by Alembic migrations:
DATABASE_DIRECT_URL=postgresql+asyncpg://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB
CORS_ORIGINS=http://localhost:5173
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AUTO_CREATE_TABLES=true
